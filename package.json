{
  "name": "openclinic",
  "version": "0.1.1",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/backend-api",
    "packages/backend-cli",
    "packages/frontend-webapp"
  ],
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "cli": "tsx packages/backend-cli/src/index.ts",
    "setup": "node infra/scripts/setup.mjs",
    "setup:quick": "node infra/scripts/setup.mjs --quickstart",
    "setup:docker": "node infra/scripts/setup.mjs",
    "dev": "pnpm --filter @openclinic/backend-api --filter @openclinic/frontend-webapp --parallel dev",
    "dev:api": "pnpm --filter @openclinic/backend-api dev",
    "dev:webapp": "pnpm --filter @openclinic/frontend-webapp dev",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run --if-present test && pnpm run test:secrets",
    "test:secrets": "node --test infra/secrets/runtime.test.mjs",
    "test:secrets:swarm": "node infra/secrets/swarm-smoke.mjs",
    "typecheck": "pnpm --filter @openclinic/core build && tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/backend-api/tsconfig.json && tsc --noEmit -p packages/backend-cli/tsconfig.json && tsc --noEmit -p packages/frontend-webapp/tsconfig.json",
    "export:openapi": "pnpm --filter @openclinic/backend-api export:openapi",
    "compliance": "node infra/compliance/runner.mjs",
    "compliance:quick": "node infra/compliance/runner.mjs verify --profile local --non-interactive",
    "compliance:report": "node infra/compliance/runner.mjs guide --task review --non-interactive",
    "compliance:full": "node infra/compliance/runner.mjs verify --profile integration --non-interactive",
    "db:setup": "pnpm run cli -- db:setup",
    "db:status": "pnpm run cli -- db:status",
    "db:check": "pnpm run cli -- db:check",
    "db:baseline": "pnpm run cli -- db:baseline",
    "db:generate": "pnpm --filter @openclinic/backend-api db:generate",
    "db:verify": "tsx infra/database/verify-migrations.ts",
    "test:migrations": "tsx --test infra/database/tests/*.test.ts infra/database/tests/*.test.mjs",
    "test:api:functional": "node infra/testing/run-functional.mjs",
    "verify:agenda-readiness": "node infra/testing/agenda-readiness.mjs",
    "db:init": "pnpm run cli -- db:init",
    "db:migrate": "pnpm run cli -- db:migrate",
    "db:seed": "pnpm run cli -- db:seed",
    "db:backup": "pnpm run cli -- db:backup",
    "db:restore": "pnpm run cli -- db:restore",
    "db:sync-remote": "pnpm run cli -- db:sync-remote",
    "auth:check": "pnpm run cli -- auth:check",
    "user:create-admin": "pnpm run cli -- user:create-admin",
    "user:reset-password": "pnpm run cli -- user:reset-password",
    "compliance:catalog": "node infra/compliance/runner.mjs catalog validate",
    "compliance:test": "node --test infra/compliance/tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
